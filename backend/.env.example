# Copy this file to .env for local Netlify Dev, and set the same keys as
# environment variables in your Netlify site dashboard (Site settings > Environment variables)
# for production. NEVER commit a real .env file.

# --- Payments (PayPal) ---
# Create an app at https://developer.paypal.com/dashboard/applications to get
# these. Use the "Sandbox" app credentials while testing.
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
# 'sandbox' (default, for testing) or 'live' (real money)
PAYPAL_ENV=sandbox
# Get this when you register a webhook at https://developer.paypal.com/dashboard/webhooks
# pointing to: https://your-backend-site.netlify.app/.netlify/functions/payment-webhook
# Subscribe at least to the "Payment capture completed" event.
PAYPAL_WEBHOOK_ID=REPLACE_ME

# --- Email (SendGrid) ---
# Get an API key from https://app.sendgrid.com/settings/api_keys
EMAIL_API_KEY=SG.REPLACE_ME
# Must be a verified sender address/domain in SendGrid (Settings > Sender Authentication)
EMAIL_FROM=no-reply@yourdomain.com

# --- Secure download links ---
# Any long, random string. Generate one with: openssl rand -hex 32
DOWNLOAD_LINK_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# --- Misc ---
# Where customers should reach you for support (also shown in emails/footer)
SUPPORT_EMAIL=support@yourdomain.com
# The public URL of your deployed FRONTEND (used to build links in emails and
# CORS allow-origin checks). For local dev this is usually http://localhost:5173
SITE_URL=https://yourname.github.io/your-repo

# --- Optional: real file storage base URL for paid product downloads ---
# e.g. a private S3 bucket or Supabase Storage bucket URL.
PRODUCT_FILE_BASE_URL=https://your-private-file-storage.example.com/products
