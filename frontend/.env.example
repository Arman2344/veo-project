# Copy this file to .env (for local dev) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# Base URL of your deployed Netlify Functions backend, e.g.:
# https://your-site-name.netlify.app/.netlify/functions
# When running Netlify Dev locally, this is typically http://localhost:8888/.netlify/functions
VITE_API_BASE_URL=http://localhost:8888/.netlify/functions
